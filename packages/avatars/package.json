{
  "name": "@appkit/avatars",
  "version": "0.2.0",
  "description": "AI avatar/image generation through the AI SDK provider layer \u2014 pass your @appkit/ai tenant AiConfig; openai and google image models.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22"
  },
  "author": "Braedon Saunders",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braedonsaunders/appkit.git",
    "directory": "packages/avatars"
  },
  "homepage": "https://github.com/braedonsaunders/appkit/tree/main/packages/avatars#readme",
  "bugs": {
    "url": "https://github.com/braedonsaunders/appkit/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "appkit",
    "avatars",
    "image-generation",
    "application-framework",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": false,
    "provenance": true
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.91",
    "@ai-sdk/openai": "^3.0.84",
    "ai": "^6.0.224"
  }
}
