    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@appkit/ui": "^0.1.7",
    "framer-motion": "^12.34.0",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@appkit/ui": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@appkit/ui": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "framer-motion": "^12.34.0",
    "lucide-react": "^1.24.0"
  },
  "author": "Braedon Saunders",
  "repository": {
    "type": "git",
